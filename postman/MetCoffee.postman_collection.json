{
  "info": {
    "name": "Met Coffee API",
    "_postman_id": "met-coffee-api-tests",
    "description": "Pruebas de API para una instancia local configurada con MongoDB de pruebas. No ejecutar contra Atlas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "if (requestName === 'Registrar usuario') {",
          "  const suffix = Date.now().toString();",
          "  pm.environment.set('usuarioPrueba', 'postman_' + suffix);",
          "  pm.environment.set('correoPrueba', 'postman_' + suffix + '@test.local');",
          "  pm.environment.unset('productoId');",
          "  pm.environment.unset('direccionId');",
          "  pm.environment.unset('pedidoId');",
          "}",
          "const clientToken = pm.environment.get('clienteToken');",
          "const adminToken = pm.environment.get('adminToken');",
          "const requestUrl = pm.request.url.toString();",
          "if (/\\/api\\/admin\\//.test(requestUrl) && requestName !== 'Acceso administrativo sin token') {",
          "  if (!adminToken) { pm.execution.skipRequest(); }",
          "  else { pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + adminToken }); }",
          "}",
          "if (clientToken && /\\/api\\/(cuenta\\/[^/]+\\/fusionar-carrito|carrito|domicilios|compras|pedidos)/.test(requestUrl)) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + clientToken });",
          "}",
          "const needsProduct = ['Consultar producto', 'Configurar bolsa', 'Agregar producto al carrito', 'Agregar bolsa al carrito', 'Actualizar item', 'Eliminar item', 'Actualizar producto admin', 'Subir imagen admin', 'Desactivar producto admin', 'Consultar inventario', 'Ajustar inventario', 'Movimientos de producto', 'Confirmar compra con domicilio inexistente (caso negativo)'];",
          "if (needsProduct.includes(requestName) && !pm.environment.get('productoId')) { pm.execution.skipRequest(); }",
          "const needsAddress = ['Actualizar domicilio', 'Seleccionar domicilio principal', 'Confirmar compra con domicilio inexistente (caso negativo)'];",
          "if (needsAddress.includes(requestName) && !pm.environment.get('direccionId')) { pm.execution.skipRequest(); }",
          "const needsOrder = ['Detalle de pedido', 'Cancelar pedido', 'Detalle pedido admin', 'Actualizar estado pedido admin'];",
          "if (needsOrder.includes(requestName) && !pm.environment.get('pedidoId')) { pm.execution.skipRequest(); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('La respuesta tiene código HTTP', function () { pm.expect(pm.response.code).to.be.a('number'); });",
          "if (pm.response.text()) { pm.test('El cuerpo JSON es válido cuando existe', function () { pm.response.json(); }); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Cuenta",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro creado con HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('El registro devuelve un ID y rol de cliente', () => { pm.expect(body.id).to.be.a('string').and.not.empty; pm.expect(body.rol).to.eql('CLIENTE'); });",
                  "pm.environment.set('usuarioId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"{{usuarioPrueba}}\",\n  \"correo\": \"{{correoPrueba}}\",\n  \"password\": \"{{passwordPrueba}}\",\n  \"telefono\": \"3001234567\"\n}"
            },
            "url": "{{baseUrl}}/api/cuenta/registro"
          }
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto con HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Login devuelve JWT y usuario', () => { pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.usuario.id).to.eql(pm.environment.get('usuarioId')); });",
                  "pm.environment.set('clienteToken', body.token);",
                  "pm.environment.set('usuarioId', body.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoPrueba}}\",\n  \"password\": \"{{passwordPrueba}}\"\n}"
            },
            "url": "{{baseUrl}}/api/cuenta/login"
          }
        },
        {
          "name": "Iniciar sesión administrador (requiere variables locales)",
          "disabled": false,
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('adminCorreo') || !pm.environment.get('adminPassword')) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login administrativo correcto', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Se recibe un JWT de administrador', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/cuenta/login"
          }
        },
        {
          "name": "Fusionar carrito visitante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"visitante\",\n  \"items\": []\n}"
            },
            "url": "{{baseUrl}}/api/cuenta/{{usuarioId}}/fusionar-carrito"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El carrito visitante se fusiona sin contenido de respuesta (HTTP 204)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con credenciales incorrectas (caso negativo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/cuenta/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"no-existe-{{$timestamp}}@test.local\",\n  \"password\": \"ClaveIncorrecta123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales incorrectas son rechazadas con HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('La API informa el error de autenticación', () => pm.expect(pm.response.json().message).to.eql('Credenciales inválidas'));"
                ]
              }
            }
          ]
        }
      ]
    },
