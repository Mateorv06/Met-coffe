                  "pm.test('El domicilio se actualiza con HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Se devuelve la dirección actualizada', () => pm.expect(pm.response.json().direccion).to.eql('Calle de pruebas 456'));"
                ]
              }
            }
          ]
