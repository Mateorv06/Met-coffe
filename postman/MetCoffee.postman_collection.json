        {
          "name": "Confirmar compra con domicilio inexistente (caso negativo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/compras/{{usuarioId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccionId\": \"domicilio-inexistente-postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La compra con domicilio inexistente se rechaza con HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('La API informa que el domicilio no existe', () => pm.expect(pm.response.json().message).to.eql('Domicilio no encontrado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar compra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hayProducto = !!pm.environment.get('productoId');",
                  "if (hayProducto) {",
                  "  pm.test('La compra se confirma con HTTP 201', () => pm.response.to.have.status(201));",
                  "  const body = pm.response.json();",
                  "  pm.test('La respuesta contiene pedido, total e items', () => { pm.expect(body.id).to.be.a('string').and.not.empty; pm.expect(body.total).to.be.a('number').and.above(0); pm.expect(body.items).to.be.an('array').that.is.not.empty; });",
                  "  pm.environment.set('pedidoId', body.id);",
                  "} else {",
                  "  pm.test('Sin producto preparado, el carrito vacío se rechaza con HTTP 409', () => pm.response.to.have.status(409));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccionId\": \"{{direccionId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/compras/{{usuarioId}}"
          }
        }
      ]
